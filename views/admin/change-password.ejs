<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="robots" content="noindex, nofollow">
  <title>Account Settings - Studio Admin</title>
  <link rel="stylesheet" href="/css/admin.css">
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
  <style>
    .account-card { max-width: 480px; background: #fff; border-radius: 16px; padding: 32px; box-shadow: 0 4px 20px rgba(0,0,0,0.08); }
    .account-card h2 { font-size: 1.1rem; color: #333; margin-bottom: 20px; padding-bottom: 12px; border-bottom: 1px solid #f0f0f0; }
    .account-card .avatar { width: 64px; height: 64px; border-radius: 50%; background: linear-gradient(135deg, #c2a06b, #a8863a); display: flex; align-items: center; justify-content: center; font-size: 1.5rem; color: #fff; font-weight: 700; margin-bottom: 20px; }
    .field-group { margin-bottom: 18px; }
    .field-group label { display: block; font-size: 0.8rem; font-weight: 600; color: #555; margin-bottom: 6px; }
    .field-group input { width: 100%; padding: 11px 14px; border: 1px solid #ddd; border-radius: 8px; font-size: 0.95rem; font-family: inherit; transition: border-color 0.3s; background: #fafafa; }
    .field-group input:focus { outline: none; border-color: #c2a06b; background: #fff; }
    .field-group .hint { font-size: 0.75rem; color: #999; margin-top: 4px; }
    .section-divider { font-size: 0.75rem; text-transform: uppercase; letter-spacing: 0.1em; color: #c2a06b; margin: 24px 0 14px; font-weight: 600; }
    .btn-row { display: flex; gap: 10px; margin-top: 24px; }
    .btn-row .btn { flex: 1; text-align: center; }
    .btn-cancel { background: #f3f4f6; color: #555; text-decoration: none; display: inline-block; padding: 10px 20px; border-radius: 8px; font-size: 0.9rem; font-weight: 600; text-align: center; }
    .btn-cancel:hover { background: #e5e7eb; }
    .last-login { font-size: 0.78rem; color: #999; margin-top: 20px; padding-top: 16px; border-top: 1px solid #f0f0f0; }
  </style>
</head>
<body>
  <div class="admin-layout">
    <%- include('sidebar') %>
    <main class="admin-main">
      <div class="admin-header">
        <h1>Account Settings</h1>
        <div class="admin-user">Welcome, <%= admin.username %></div>
      </div>

      <% if (error) { %>
        <div class="alert alert-error"><%= error %></div>
      <% } %>
      <% if (success) { %>
        <div class="alert alert-success"><%= success %></div>
      <% } %>

      <div class="account-card">
        <div class="avatar"><%= admin.username.charAt(0).toUpperCase() %></div>

        <form action="/admin/auth/change-password" method="POST">
          <h2>Profile</h2>
          <div class="field-group">
            <label for="username">Username</label>
            <input type="text" id="username" name="username" value="<%= admin.username %>" required minlength="3">
            <div class="hint">Min 3 characters. This is your login name.</div>
          </div>

          <div class="section-divider">Verify Identity</div>
          <div class="field-group">
            <label for="currentPassword">Current Password</label>
            <input type="password" id="currentPassword" name="currentPassword" required autocomplete="current-password">
            <div class="hint">Required to save any changes.</div>
          </div>

          <div class="section-divider">New Password (optional)</div>
          <div class="field-group">
            <label for="newPassword">New Password</label>
            <input type="password" id="newPassword" name="newPassword" autocomplete="new-password" placeholder="Leave blank to keep current">
          </div>
          <div class="field-group">
            <label for="confirmPassword">Confirm New Password</label>
            <input type="password" id="confirmPassword" name="confirmPassword" autocomplete="new-password" placeholder="Repeat new password">
          </div>

          <div class="btn-row">
            <a href="/admin/dashboard" class="btn-cancel">Cancel</a>
            <button type="submit" class="btn btn-primary">Save Changes</button>
          </div>
        </form>

        <div class="last-login">Account created: <%= admin.created_at ? new Date(admin.created_at).toLocaleDateString('en', { month: 'long', day: 'numeric', year: 'numeric' }) : 'N/A' %></div>
      </div>
    </main>
  </div>
</body>
</html>
