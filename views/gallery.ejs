<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= gallery.client_name %> — Gallery</title>
  <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,500;1,400&family=Jost:wght@300;400;500&display=swap" rel="stylesheet">
  <style>
    * { margin: 0; padding: 0; box-sizing: border-box; }
    body { background: #0f0e0c; color: #fff; font-family: 'Jost', sans-serif; min-height: 100vh; }

    .header { text-align: center; padding: 60px 20px 40px; }
    .header .kicker { font-size: 12px; letter-spacing: 3px; text-transform: uppercase; color: #c2a06b; margin-bottom: 12px; }
    .header h1 { font-family: 'Cormorant Garamond', serif; font-size: 42px; font-weight: 400; margin-bottom: 8px; }
    .header .meta { font-size: 14px; color: #888; }
    .header .meta span { margin: 0 8px; }

    .grid { max-width: 1400px; margin: 0 auto; padding: 0 20px 60px; columns: 4; column-gap: 8px; }
    @media (max-width: 1024px) { .grid { columns: 3; } }
    @media (max-width: 640px) { .grid { columns: 2; } }

    .grid-item { break-inside: avoid; margin-bottom: 8px; border-radius: 4px; overflow: hidden; cursor: pointer; position: relative; }
    .grid-item img { width: 100%; display: block; transition: transform 0.3s; }
    .grid-item:hover img { transform: scale(1.03); }

    /* Lightbox */
    .lightbox { display: none; position: fixed; inset: 0; background: rgba(0,0,0,0.95); z-index: 100; align-items: center; justify-content: center; }
    .lightbox.active { display: flex; }
    .lightbox img { max-width: 90vw; max-height: 90vh; object-fit: contain; border-radius: 4px; }
    .lightbox .close { position: absolute; top: 20px; right: 20px; background: none; border: none; color: #fff; font-size: 28px; cursor: pointer; z-index: 101; }
    .lightbox .nav-btn { position: absolute; top: 50%; transform: translateY(-50%); background: rgba(255,255,255,0.1); border: none; color: #fff; width: 48px; height: 48px; border-radius: 50%; cursor: pointer; font-size: 20px; display: flex; align-items: center; justify-content: center; }
    .lightbox .nav-btn:hover { background: rgba(255,255,255,0.2); }
    .lightbox .prev { left: 20px; }
    .lightbox .next { right: 20px; }
    .lightbox .counter { position: absolute; bottom: 20px; left: 50%; transform: translateX(-50%); color: #888; font-size: 14px; }

    .footer { text-align: center; padding: 40px 20px; color: #555; font-size: 13px; border-top: 1px solid #1a1a1a; }
    .footer a { color: #c2a06b; text-decoration: none; }

    .empty { text-align: center; padding: 80px 20px; color: #555; }
  </style>
</head>
<body>
  <div class="header">
    <p class="kicker">Client Gallery</p>
    <h1><%= gallery.client_name %></h1>
    <div class="meta">
      <% if (gallery.event_type) { %><span><%= gallery.event_type %></span><% } %>
      <% if (gallery.location) { %><span>· <%= gallery.location %></span><% } %>
      <% if (gallery.event_date) { %><span>· <%= new Date(gallery.event_date + 'T00:00:00').toLocaleDateString('en', { month: 'long', day: 'numeric', year: 'numeric' }) %></span><% } %>
    </div>
    <% if (gallery.description) { %><p style="margin-top:12px;color:#aaa;font-size:15px"><%= gallery.description %></p><% } %>
  </div>

  <% if (images.length === 0) { %>
  <div class="empty"><p>No photos in this gallery yet.</p></div>
  <% } else { %>
  <div class="grid">
    <% images.forEach(function(img, i) { %>
    <div class="grid-item" data-index="<%= i %>">
      <img src="<%= img.url %>" alt="<%= img.original_name || '' %>" loading="lazy">
    </div>
    <% }) %>
  </div>
  <% } %>

  <!-- Lightbox -->
  <div class="lightbox" id="lightbox">
    <button class="close" id="lbClose">&times;</button>
    <button class="nav-btn prev" id="lbPrev">&#8249;</button>
    <img id="lbImg" src="" alt="">
    <button class="nav-btn next" id="lbNext">&#8250;</button>
    <div class="counter" id="lbCounter"></div>
  </div>

  <div class="footer">
    <p><%= gallery.client_name %> · Captured by <a href="/">Isabella Marchetti</a></p>
  </div>

  <script>
    (function () {
      var items = document.querySelectorAll('.grid-item');
      var lightbox = document.getElementById('lightbox');
      var lbImg = document.getElementById('lbImg');
      var lbCounter = document.getElementById('lbCounter');
      var current = 0;
      var urls = [];

      items.forEach(function (item, i) {
        var img = item.querySelector('img');
        urls.push(img.src);
        item.addEventListener('click', function () { openLightbox(i); });
      });

      function openLightbox(i) {
        current = i;
        lbImg.src = urls[current];
        lbCounter.textContent = (current + 1) + ' / ' + urls.length;
        lightbox.classList.add('active');
        document.body.style.overflow = 'hidden';
      }

      function closeLightbox() {
        lightbox.classList.remove('active');
        document.body.style.overflow = '';
      }

      document.getElementById('lbClose').onclick = closeLightbox;
      lightbox.addEventListener('click', function (e) { if (e.target === lightbox) closeLightbox(); });

      document.getElementById('lbPrev').onclick = function () {
        current = (current - 1 + urls.length) % urls.length;
        lbImg.src = urls[current];
        lbCounter.textContent = (current + 1) + ' / ' + urls.length;
      };

      document.getElementById('lbNext').onclick = function () {
        current = (current + 1) % urls.length;
        lbImg.src = urls[current];
        lbCounter.textContent = (current + 1) + ' / ' + urls.length;
      };

      document.addEventListener('keydown', function (e) {
        if (!lightbox.classList.contains('active')) return;
        if (e.key === 'Escape') closeLightbox();
        if (e.key === 'ArrowLeft') document.getElementById('lbPrev').click();
        if (e.key === 'ArrowRight') document.getElementById('lbNext').click();
      });
    })();
  </script>
</body>
</html>
