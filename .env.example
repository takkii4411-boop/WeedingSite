# Storage backend: "r2" (default, fast) or "telegram" (free, 50MB limit)
STORAGE_BACKEND=r2

# Cloudflare R2 Storage — https://dash.cloudflare.com → R2
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_URL=

# Telegram Bot Storage (free, unlimited, 50MB per file)
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=

# Session secret (any long random string)
SESSION_SECRET=

# Optional SMTP for inquiry emails
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=
# NOTIFY_EMAIL=
